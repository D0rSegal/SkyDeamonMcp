# Copy to .env (never commit real credentials)
SKYDEMON_LOGIN=
SKYDEMON_PASSWORD=

# MCP OAuth 2.0 Client Credentials (for Gemini / remote agents)
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
# Your Gemini Custom Connector redirect URI (Custom MCP -> copy it from the Gemini connect screen)
MCP_OAUTH_REDIRECT_URI=https://oauth-redirect.googleusercontent.com/r/<your-connector-id>
